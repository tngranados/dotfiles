{
  "providers": {
    "meta": {
      "name": "Meta Model API",
      "baseUrl": "https://api.meta.ai/v1",
      "apiKey": "$META_API_KEY",
      "api": "openai-responses",
      "models": [
        {
          "id": "muse-spark-1.3-contributor",
          "name": "Muse Spark 1.3 Contributor",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": "none",
            "minimal": "minimal",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": null
          },
          "input": ["text", "image"],
          "cost": { "input": 0.1, "output": 0.2, "cacheRead": 0.002, "cacheWrite": 0.1 },
          "contextWindow": 1048576,
          "maxTokens": 131072
        }
      ]
    }
  }
}
